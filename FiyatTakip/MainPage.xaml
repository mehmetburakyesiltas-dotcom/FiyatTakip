<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FiyatTakip.MainPage"
             BackgroundColor="#000000">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25" VerticalOptions="Start">

            <Image Source="aslanlogo.png" 
                   HeightRequest="220" 
                   WidthRequest="220" 
                   Aspect="AspectFit" 
                   HorizontalOptions="Center" 
                   Margin="0,30,0,0" />

            <Border Stroke="#D4AF37" StrokeThickness="1.5" BackgroundColor="#0F0F0F" Padding="25" StrokeShape="RoundRectangle 40" Margin="10,0">
                <VerticalStackLayout Spacing="28">

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Gram Altın" TextColor="#D4AF37" FontSize="18" />
                        <Label x:Name="LblGram" Text="--- TL" Grid.Column="1" TextColor="White" FontSize="20" FontAttributes="Bold" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Çeyrek Altın" TextColor="#D4AF37" FontSize="18" />
                        <Label x:Name="LblCeyrek" Text="--- TL" Grid.Column="1" TextColor="White" FontSize="20" FontAttributes="Bold" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Yarım Altın" TextColor="#D4AF37" FontSize="18" />
                        <Label x:Name="LblYarim" Text="--- TL" Grid.Column="1" TextColor="White" FontSize="20" FontAttributes="Bold" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Tam Altın" TextColor="#D4AF37" FontSize="18" />
                        <Label x:Name="LblTam" Text="--- TL" Grid.Column="1" TextColor="White" FontSize="20" FontAttributes="Bold" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#D4AF37" Opacity="0.3" Margin="0,5" />

                    <Grid ColumnDefinitions="*, *">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="DOLAR ($)" TextColor="#888" FontSize="12" />
                            <Label x:Name="LblDolar" Text="---" TextColor="#00FF7F" FontSize="18" FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                            <Label Text="EURO (€)" TextColor="#888" FontSize="12" HorizontalOptions="End" />
                            <Label x:Name="LblEuro" Text="---" TextColor="#00FF7F" FontSize="18" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="PİYASAYI TAZELE" 
                    Clicked="OnUpdateClicked" 
                    BackgroundColor="Transparent" 
                    BorderColor="#D4AF37" 
                    BorderWidth="1" 
                    TextColor="#D4AF37" 
                    HeightRequest="55" 
                    CornerRadius="10" 
                    Margin="10,0"/>

            <Label Text="Yönetici Paneli" 
                   TextColor="#444" 
                   HorizontalOptions="Center" 
                   FontSize="12" 
                   Margin="0,10,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAdminEntryTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label x:Name="LblStatus" 
                   Text="Veri bekleniyor..." 
                   TextColor="#444" 
                   HorizontalOptions="Center" 
                   FontSize="10" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>